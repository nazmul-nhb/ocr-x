    "fixmat": "biome check --write --diagnostic-level=warn && biome format --write --diagnostic-level=warn",
    "migrate": "biome migrate --write",
    "commit": "nhb-commit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "locality-idb": "^2.6.3",
    "lucide-react": "^1.31.0",
    "nhb-hooks": "^1.50.11",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "toolbox-x": "^2.6.20",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
